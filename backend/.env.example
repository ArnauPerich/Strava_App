STRAVA_CLIENT_ID=tu_client_id
STRAVA_CLIENT_SECRET=tu_client_secret
SECRET_KEY=cambia_esto_por_algo_aleatorio_largo
REDIRECT_URI=http://IP-DE-TU-VPS/callback
WEBHOOK_VERIFY_TOKEN=elige_un_token_secreto_aleatorio
OPENAI_API_KEY=sk-...tu_clave_de_openai
# Voz del asistente: alloy, echo, fable, onyx, nova, shimmer
OPENAI_TTS_VOICE=nova

# ── Web Push (notificaciones de objetivos) ────────────────────────────────────
# Genera un par (pública + privada) y pega AMBAS aquí. Deben ser del mismo par.
# La pública no es secreta (se entrega al navegador); la privada SÍ es secreta.
# VAPID_SUBJECT es un contacto del administrador (mailto: o https:), no se envía
# ningún correo: solo identifica al servidor ante el servicio push.
VAPID_PUBLIC_KEY=tu_clave_publica_vapid_base64url
VAPID_PRIVATE_KEY=tu_clave_privada_vapid_base64url
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
